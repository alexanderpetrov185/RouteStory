<?xml version="1.0" encoding="utf-8"?>
<!-- Private user data must not leave the device via cloud backup or device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="photos/" />
        <exclude domain="file" path="videos/" />
        <exclude domain="file" path="datastore/" />
        <exclude domain="database" path="routestory.db" />
        <exclude domain="database" path="routestory.db-wal" />
        <exclude domain="database" path="routestory.db-shm" />
        <exclude domain="database" path="routestory.db-journal" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="photos/" />
        <exclude domain="file" path="videos/" />
        <exclude domain="file" path="datastore/" />
        <exclude domain="database" path="routestory.db" />
        <exclude domain="database" path="routestory.db-wal" />
        <exclude domain="database" path="routestory.db-shm" />
        <exclude domain="database" path="routestory.db-journal" />
    </device-transfer>
</data-extraction-rules>